{
    "name": "montemove-core",
    "version": "1.0.0",
    "private": true,
    "description": "MonteMove Core - Monorepo",
    "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
    "scripts": {
        "dev": "pnpm --parallel --stream run dev",
        "dev:api": "dotenv -e .env -- pnpm --filter @montemove/api run start:dev",
        "dev:frontend": "dotenv -e .env -- pnpm --filter @montemove/frontend run dev",
        "build": "pnpm --recursive run build",
        "build:api": "pnpm --filter @montemove/api run build",
        "build:frontend": "pnpm --filter @montemove/frontend run build",
        "start:api": "pnpm --filter @montemove/api run start:prod",
        "start:frontend": "pnpm --filter @montemove/frontend run start",
        "lint": "pnpm --recursive run lint",
        "lint:fix": "pnpm --recursive run lint --fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "test": "pnpm --recursive run test",
        "test:api": "pnpm --filter @montemove/api run test",
        "clean": "pnpm --recursive exec rm -rf node_modules dist .next",
        "db:generate": "dotenv -e .env -- pnpm --filter @montemove/api run prisma:generate",
        "db:migrate": "dotenv -e .env -- pnpm --filter @montemove/api run prisma:dev",
        "db:push": "dotenv -e .env -- pnpm --filter @montemove/api run prisma:push",
        "db:deploy": "dotenv -e .env -- pnpm --filter @montemove/api run prisma:deploy",
        "db:studio": "dotenv -e .env -- pnpm --filter @montemove/api run prisma:studio",
        "db:reset": "dotenv -e .env -- pnpm --filter @montemove/api run prisma:reset",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down"
    },
    "devDependencies": {
        "cpx": "^1.5.0",
        "dotenv-cli": "^7.4.2",
        "dotenv-expand": "^11.0.7",
        "prettier": "^3.4.2"
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "dependencies": {
        "pg": "^8.20.0"
    }
}
